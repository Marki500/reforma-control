VITE_SUPABASE_URL=https://api-reforma.noxumlab.com
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Optional runtime overrides. Use the same Supabase project as the frontend.
# SUPABASE_URL=https://api-reforma.noxumlab.com
# SUPABASE_ANON_KEY=your-public-anon-key
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.8-flash
# Use "openrouter" to process budget PDFs through OpenRouter instead.
AI_PROVIDER=gemini
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_PDF_ENGINE=pdf-text
# Keep paid models and paid PDF OCR blocked. Leave this enabled while NIVEL must remain free.
AI_FREE_ONLY=true

# Server-only transactional email. Never expose these as VITE_ variables.
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
MAIL_FROM_EMAIL=notificaciones@noxumlab.com
MAIL_FROM_NAME=NIVEL
APP_PUBLIC_URL=https://your-nivel-domain.example
