VITE_SUPABASE_URL=https://api-reforma.noxumlab.com
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Optional runtime overrides. Use the same Supabase project as the frontend.
# SUPABASE_URL=https://api-reforma.noxumlab.com
# SUPABASE_ANON_KEY=your-public-anon-key
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.8-flash
# Use "openrouter" to process budget PDFs through OpenRouter instead.
AI_PROVIDER=gemini
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_PDF_ENGINE=pdf-text
